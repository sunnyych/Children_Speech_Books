## Property types processing
```{r}
books_properties <- map(
  c(
    here(DATA_LOC, "books_generics.csv"),
    here(DATA_LOC, "books_habituals.csv"),
    here(DATA_LOC, "books_quantifiers.csv")
  ), 
  \(f) read_csv(
    f, col_types = cols_only(
      sentence = "c",
      classification = "c",
      age_min = "d",
      age_max = "d"))) |> 
  list_rbind() |> 
  distinct() |> 
  group_by(sentence, age_min, age_max) |> 
  summarise(classification = paste0(classification, collapse = ","),
            .groups = "drop")

books_properties_merged <- books_matched |> 
  left_join(books_properties, by = join_by(sentence, age_min, age_max)) |> 
  filter(sentence_type != "other") |> 
  mutate(classification = strsplit(classification, split = ",")) |> 
  unnest(cols = classification) |> 
  distinct() |> 
  mutate(classification = case_when(
    classification == 1 ~ "behavioral",
    classification == 2 ~ "biological",
    classification == 3 ~ "social",
    classification == 4 ~ "teleological",
    classification == 5 ~ "perceptual",
    .default = "none"
  )) |> 
  mutate(value = 1) |> 
  pivot_wider(names_from = classification) |> 
  mutate(
    none = case_when(
      behavioral | biological | social | teleological | perceptual ~ NA,
      none == 1 ~ 1,
      .default = NA
    ),
    across(c(behavioral, biological, social, teleological, perceptual, none),
           \(c) replace_na(c, 0)),
    sentence_type = sentence_type |> fct_drop())
```

## Property types model
```{r}
books_mod_prop <- multinom(sentence_type ~ subject_kind * 
                             (behavioral + biological + social + teleological + perceptual),
                           data = books_properties_merged |> filter(!is_pronoun))
books_emm_prop <- emmeans(books_mod_prop, ~ subject_kind *
                            (behavioral + biological + social + teleological + perceptual) | sentence_type) |> 
  subset(behavioral + biological + social + teleological + perceptual == 1)
books_con_prop <- contrast(books_emm_prop,
                           by = c("subject_kind", "sentence_type"),
                           method = "pairwise")

books_emm_prop_out <- books_emm_prop |> tidy(conf.int = TRUE) |> 
  pivot_longer(cols = all_of(property_types), 
               names_to = "property_type",
               values_to = "value") |> 
  filter(value == 1) |> 
  select(-value) |> 
  write_csv(here(OUTPUT_LOC, "books_emm_properties.csv"))
books_con_prop_out <- books_con_prop |> tidy() |> 
  mutate(term = "property_kind",
         contrast = contrast |> 
           str_remove_all("[a-z]+0") |> 
           str_remove_all("1") |> 
           str_squish()) |> 
  write_csv(here(OUTPUT_LOC, "books_con_properties.csv"))
```

