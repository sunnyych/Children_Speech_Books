```{r}

library(dplyr)
library(ggplot2)

# -------------------------
# Step 1. Label the data frames
# -------------------------
books_matched$dataset           <- "books (including pronouns)"
speech_matched$dataset          <- "speech (including pronouns)"
books_matched_noprons$dataset   <- "books (excluding pronouns)"
speech_matched_noprons$dataset  <- "speech (excluding pronouns)"

# -------------------------
# Step 2. Combine the data frames
# -------------------------
all_df <- bind_rows(books_matched, speech_matched,
                    books_matched_noprons, speech_matched_noprons)

# -------------------------
# Step 2.5. Filter to desired subject kinds
# -------------------------
all_df <- all_df %>% 
  filter(subject_kind %in% c("artifacts", "biological", "nonliving", "social"))

# -------------------------
# Step 3. Prepare the bar plot data (plot_df)
# -------------------------
# (These proportions are computed per subject kind within each dataset)
totals <- all_df %>%
  group_by(dataset, subject_kind) %>%
  summarize(total = n(), .groups = "drop")

plot_df <- all_df %>%
  filter(sentence_type %in% c("generic", "habitual", "universal_quantification")) %>%
  group_by(dataset, subject_kind, sentence_type) %>%
  summarize(count = n(), .groups = "drop") %>%
  left_join(totals, by = c("dataset", "subject_kind")) %>%
  mutate(proportion = count / total,
         se         = sqrt(proportion * (1 - proportion) / total),
         lower      = pmax(proportion - 1.96 * se, 0),
         upper      = pmin(proportion + 1.96 * se, 1)) %>%
  # Change "universal_quantification" label to include a line break.
  mutate(sentence_type = recode(sentence_type,
                                universal_quantification = "universally\nquantified"))

# Set sentence_type as a factor with fixed levels (this ensures consistency in positioning)
plot_df$sentence_type <- factor(plot_df$sentence_type, 
                                levels = c("generic", "habitual", "universally\nquantified"))

# -------------------------
# Step 4. Compute the base rate for each sentence type in each dataset.
# -------------------------
# Here, for each dataset and sentence type (across all sentences), the base rate is computed.
base_rate_df <- all_df %>%
  filter(sentence_type %in% c("generic", "habitual", "universal_quantification")) %>%
  group_by(dataset, sentence_type) %>%
  summarize(count = n(), .groups = "drop") %>%
  left_join(
    all_df %>% group_by(dataset) %>% summarize(total = n(), .groups = "drop"),
    by = "dataset"
  ) %>%
  mutate(base_rate = count / total) %>%
  mutate(sentence_type = recode(sentence_type,
                                universal_quantification = "universally\nquantified"))

# Ensure the sentence_type factor levels match those in plot_df.
base_rate_df$sentence_type <- factor(base_rate_df$sentence_type, 
                                     levels = c("generic", "habitual", "universally\nquantified"))

# -------------------------
# Step 5. Create the plot
# -------------------------
p <- ggplot(plot_df, aes(x = sentence_type, y = proportion, fill = subject_kind)) +
  # Bar plot with black outlines
  geom_bar(stat = "identity", position = position_dodge(width = 0.9), color = "black") +
  # Vertical error lineranges
  geom_linerange(aes(ymin = lower, ymax = upper),
                 position = position_dodge(width = 0.9)) +
  # Add the base rate dotted lines.
  # We convert the discrete sentence_type to numeric positions.
  geom_segment(data = base_rate_df,
               aes(x = as.numeric(sentence_type) - 0.45,
                   xend = as.numeric(sentence_type) + 0.45,
                   y = base_rate,
                   yend = base_rate,
                   linetype = "Base rate"),
               inherit.aes = FALSE,
               color = "black",
               size = 0.8) +
  facet_wrap(~ dataset, nrow = 1) +
  labs(x = "", y = "Proportion", fill = "Subject Kind") +  # Remove x-axis label
  theme_minimal(base_size = 16) +
  theme(
    # White backgrounds for panels, plot, and facet labels.
    panel.background = element_rect(fill = "white", color = NA),
    plot.background  = element_rect(fill = "white", color = NA),
    strip.background = element_rect(fill = "white", color = NA),
    # Remove vertical grid lines.
    panel.grid.major.x = element_blank(),
    panel.grid.minor.x = element_blank(),
    # Increase font sizes for axis text.
    axis.title = element_text(size = 18),
    axis.text.x = element_text(size = 16),
    axis.text.y = element_text(size = 16),
    legend.title = element_text(size = 16),
    legend.text  = element_text(size = 14),
    panel.spacing = unit(1, "cm"),
    # Move legend to bottom and display it horizontally.
    legend.position = "bottom",
    legend.direction = "horizontal"
  ) +
  # Manually set the linetype for the "Base rate" so it appears as a dotted line in the legend.
  scale_linetype_manual(name = "", values = c("Base rate" = "dotted"),
                        guide = guide_legend(override.aes = list(color = "black")))

# -------------------------
# Step 6. Save the plot as a PDF.
# -------------------------
ggsave("my_plot.pdf", plot = p, width = 16, height = 4)







