# Determine which subject kind has a higher proportion of "generic" sentences
higher_category <- contingency_table %>%
arrange(desc(proportion_generic)) %>%
select(subject_kind, proportion_generic)
print(higher_category)
# Load necessary library
# Load necessary library
library(dplyr)
library(tidyr)
# Count occurrences of each sentence_type within each subject_kind
counts_df <- books_matched %>%
filter(is_pronoun==FALSE) %>%
group_by(subject_kind, sentence_type) %>%
summarise(count = n(), .groups = 'drop')
# Create a wide contingency table with counts for all sentence types
contingency_table <- counts_df %>%
spread(sentence_type, count, fill = 0) %>%
filter(subject_kind %in% c("artifacts", "biological"))
# Compute proportions of each sentence type within each subject_kind
contingency_table <- contingency_table %>%
mutate(total = generic + other + habitual + universal_quantification,
proportion_generic = habitual / total)
# Print proportions for each sentence type
print(contingency_table)
# Extract only generic vs. non-generic for chi-square test
chi_square_matrix <- contingency_table %>%
transmute(subject_kind, habitual, non_generic = total - habitual) %>%
select(-subject_kind) %>%
as.matrix()
# Perform chi-square test
chi_sq_test <- chisq.test(chi_square_matrix)
# Print test results
print(chi_sq_test)
# Determine which subject kind has a higher proportion of "generic" sentences
higher_category <- contingency_table %>%
arrange(desc(proportion_generic)) %>%
select(subject_kind, proportion_generic)
print(higher_category)
